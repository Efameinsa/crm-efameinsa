# Supabase (dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SOLO server: webhooks, crons, scripts. Nunca en el cliente.

# Dashboard → Settings → Database → Connection string → URI (reemplazar [YOUR-PASSWORD]).
# Solo se usa localmente para scripts/aplicar-migracion.mjs — no la necesita la app en Vercel.
DATABASE_URL=

# Web Push (notificaciones) — generar con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Ingesta de leads desde formularios web (Astro/WordPress)
LEADS_INGEST_TOKEN=

# Vercel Cron (proteger endpoints /api/cron/*)
CRON_SECRET=

# Ingesta de gasto de campañas (POST /api/gasto-campania), llamado desde
# Make.com con el conector nativo de Google Ads/Meta Ads — Make ya hace su
# propia autenticación con la plataforma de anuncios, este token solo protege
# nuestro endpoint.
GASTO_INGEST_TOKEN=

# B5 · Marketing (dejar vacío hasta tener credenciales; ruta directa a la API,
# alternativa a Make.com — no hace falta si se usa el conector nativo de Make)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# Token del System User (Business Manager → Usuarios del sistema), permiso
# ads_read — usado por scripts/sync-meta-ads.mjs para traer gasto histórico
# y diario. Cuenta publicitaria: Administrador de anuncios → ID (sin "act_").
META_AD_ACCOUNT_ID=

# Webhook nativo de Google Ads Lead Forms (POST directo de Google a
# /api/webhooks/google-leads, sin intermediarios). Esta misma clave se pega
# en el campo "Key" del formulario, dentro del editor de Google Ads.
GOOGLE_LEADS_WEBHOOK_KEY=

# n8n (correos de alertas de leads — flujos "CRM · Timbre de lead nuevo" y
# "CRM · SLA leads esperando"). El CRM dispara el webhook; n8n manda el Gmail.
# N8N_URL y N8N_API_KEY son solo locales (administrar flujos por API);
# N8N_LEAD_WEBHOOK_URL y N8N_WEBHOOK_SECRET van también en Vercel.
N8N_URL=
N8N_API_KEY=
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
ALERTAS_CORREO_PERSONAL=
